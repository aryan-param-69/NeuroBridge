# TLS front door (used with docker-compose.tls.yml). Caddy obtains and renews a certificate for $DOMAIN automatically,
# so $DOMAIN must be a public name that points at this server and ports 80/443 must be reachable.
{$DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy frontend:80
}
