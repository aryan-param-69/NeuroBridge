# Copy to .env and change every value before any real use.
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Separate random key for searchable hashes of patient identifiers
HMAC_KEY=
# Local development (MongoDB on this machine, no auth). Production must include credentials.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=neurobridge
# Used by docker-compose only
MONGO_PASSWORD=change-me
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173

# ---- Operations (see docs/OPERATIONS.md) ----
# Retired ENCRYPTION_KEY values, comma-separated, kept only so old data stays readable during key rotation.
ENCRYPTION_KEY_PREVIOUS=
# Reverse proxies in front of the API (0 = none, 1 = nginx in docker-compose, 2 = Caddy + nginx). Wrong values weaken per-address rate limiting.
TRUSTED_PROXIES=0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=1200
# HTTPS (docker-compose.tls.yml): the public host name Caddy gets a certificate for
DOMAIN=
# Memory guard for one processing run. The default (3 GB) is too high for a 4 GB server: use about a quarter of the server's RAM.
MAX_PROCESS_BYTES=1073741824
